{
  "name": "casa-emil",
  "version": "0.1.7",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-env.mjs",
    "build": "next build",
    "analyze": "node scripts/analyze-build.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:mobile": "vitest run src/layout/mobile/__tests__/",
    "test:watch": "vitest",
    "lint": "eslint",
    "env:check": "node scripts/check-env.mjs",
    "env:check:staging": "node scripts/check-env.mjs --file=.env.staging.local --profile=staging",
    "env:check:prod": "node scripts/check-env.mjs --profile=production",
    "env:check:setup": "node scripts/check-env.mjs --setup",
    "env:check:setup:staging": "node scripts/check-env.mjs --file=.env.staging.local --profile=staging --setup",
    "env:use-staging": "node scripts/sync-staging-env.mjs",
    "env:secret": "node scripts/env-secret.mjs",
    "setup-platform-admin": "node scripts/create-platform-admin.mjs",
    "setup-platform-admin:staging": "node scripts/create-platform-admin.mjs .env.staging.local",
    "setup-admin": "node scripts/create-admin-user.mjs",
    "setup-staff": "node scripts/create-staff-users.mjs",
    "setup-staff:staging": "node scripts/create-staff-users.mjs .env.staging.local",
    "setup-admin:staging": "node scripts/create-admin-user.mjs .env.staging.local",
    "reset-staging-bookings": "node scripts/reset-staging-bookings.mjs .env.staging.local",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-iphone",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@sentry/nextjs": "^10.55.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "date-fns": "^4.2.1",
    "mrz": "^5.0.2",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.7",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
