# =============================================================================
# Casa Emil — variabile de mediu (local is local)
# Copiază:  cp .env.example .env.local
# Verifică: npm run env:check
# Setup staff: npm run env:check:setup && npm run setup-staff
# Vercel producție: docs/vercel-env.md
# =============================================================================

# --- Supabase (obligatoriu) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — DOAR server (Server Actions). NU expune în browser / Git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Staff Auth (conturi separate Supabase) ---
# Login UI: Admin / Operator → aceste email-uri
ADMIN_EMAIL=admin@casaemil.ro
OPERATOR_EMAIL=operator@casaemil.ro

# Parole inițiale — DOAR local, pentru npm run setup-staff (NU pe Vercel!)
ADMIN_INITIAL_PASSWORD=
OPERATOR_INITIAL_PASSWORD=

# Secret cookie „Administrare locație” (recomandat pe producție)
# Generează: npm run env:secret
ADMIN_LOCATION_UNLOCK_SECRET=

# --- Opțional ---
NEXT_PUBLIC_PENSION_NAME=Casa Emil

# alpha = factură test v0.1.5; omit pe producție
# NEXT_PUBLIC_RELEASE_CHANNEL=alpha

# Reset factory — DOAR dev/staging (interzis pe Vercel Production)
# ADMIN_FACTORY_RESET_ENABLED=true

# Viitor: n8n
# N8N_WEBHOOK_NEW_REQUEST=
# N8N_WEBHOOK_CONFIRMED=
