# =============================================================================
# Hospira — variabile de mediu
# Copiaza:  cp .env.example .env.local
# Verifica: npm run env:check
# =============================================================================

# --- Supabase (obligatoriu) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Hospira Platform ---
NEXT_PUBLIC_PLATFORM_DOMAIN=hospira.ro
NEXT_PUBLIC_SITE_URL=https://hospira.ro

# Platform admin — acces la /hospira-admin (email-uri separate cu virgula)
HOSPIRA_ADMIN_EMAILS=contact@hospira.ro
# Legacy (optional during transition): NESTIO_ADMIN_EMAILS=contact@hospira.ro

# Secret cookie „Administrare locatie" (recomandat pe productie)
# Genereaza: npm run env:secret
# ADMIN_LOCATION_UNLOCK_SECRET=

# --- Email (Resend) — platform only; From/reply-to come from tenant settings ---
# RESEND_API_KEY=re_xxxxx
# Optional: verified send domain if different from NEXT_PUBLIC_PLATFORM_DOMAIN
# RESEND_MAIL_DOMAIN=hospira.ro

# --- Optional ---
# alpha = canal test; omit pe productie
# NEXT_PUBLIC_RELEASE_CHANNEL=alpha

# Parola acces public (alpha gate). Vizitatorii vad ecran de parola.
# ALPHA_GATE_PASSWORD=

# Reset factory — DOAR dev/staging (interzis pe Vercel Production)
# ADMIN_FACTORY_RESET_ENABLED=true

# ============================================================================
# ONE-TIME SETUP (sterge dupa ce ai creat user-ul!)
# ============================================================================
# Folosit DOAR de: npm run setup-platform-admin
# Dupa ce contul exista in Supabase Auth, STERGE aceasta linie.
#
# ADMIN_INITIAL_PASSWORD=
