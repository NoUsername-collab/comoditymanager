# =============================================================================
# STAGING — mediu live (test / feedback)
# Copiază:  cp .env.staging.example .env.staging.local
# Verifică: npm run env:check:staging
# Setup:    npm run env:check:setup:staging && npm run setup-staff:staging
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_EMAIL=admin@casaemil.ro
OPERATOR_EMAIL=operator@casaemil.ro

# Doar pentru setup-staff local (NU pune pe Vercel)
ADMIN_INITIAL_PASSWORD=
OPERATOR_INITIAL_PASSWORD=

# Recomandat pe Vercel Preview/Staging
ADMIN_LOCATION_UNLOCK_SECRET=

NEXT_PUBLIC_PENSION_NAME=Casa Emil (test)

# Permis pe staging
ADMIN_FACTORY_RESET_ENABLED=true
