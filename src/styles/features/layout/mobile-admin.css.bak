  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem 0.85rem;
}


html[data-layout-chrome="compact"] .admin-text-action {
  min-height: var(--ml-touch-min, 2.75rem);
  padding: 0.5rem 0.85rem;
  margin: 0;
}


html[data-layout-chrome="compact"] .admin-panel table tbody a {
  min-height: var(--ml-touch-min, 2.75rem);
  display: inline-flex;
  align-items: center;
  padding: 0.25rem 0.5rem;
}


/* ── Pass 5: floating panels / XP windows / check-in modal alignment ── */
html[data-layout-chrome="compact"] .admin-floating-panel,
html[data-layout-chrome="compact"] .admin-floating-panel--modal {
  min-width: 0;
  word-break: break-word;
}


html[data-layout-chrome="compact"] .admin-floating-panel__header {
  min-width: 0;
  padding: 0.65rem 0.75rem;
}


html[data-layout-chrome="compact"] .admin-floating-panel__title {
  min-width: 0;
  word-break: break-word;
}


html[data-layout-chrome="compact"] .admin-floating-panel__body {
  min-width: 0;
  padding: 0.65rem 0.75rem;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
}


html[data-layout-chrome="compact"] .admin-floating-panel table,
html[data-layout-chrome="compact"] .checkin-modal table {
  display: block;
  max-width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
}


html[data-layout-chrome="compact"] .admin-panel {
  word-break: break-word;
}


html[data-layout-chrome="compact"] .admin-panel table {
  display: block;
  max-width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
}


html[data-layout-chrome="compact"] .checkin-modal {
  min-width: 0;
  word-break: break-word;
}


/* ── Pass 5: panel text/content alignment on compact ── */
html[data-layout-chrome="compact"] :is(
  .admin-floating-panel,
  .admin-floating-panel__body,
  .admin-panel-section,
  .admin-panel,
  .admin-panel-body,
  .bd-card,
  .availability-detail-panel,
  .admin-quick-panel,
  .ml-drawer,
  .gantt-popover-premium,
  .gantt-filters-panel
) {
  min-width: 0;
  max-width: 100%;
}


html[data-layout-chrome="compact"] :is(
  .admin-floating-panel__title,
  .bd-card__title,
  .bd-info-value,
  .ml-drawer__link,
  .gantt-popover-premium__body p,
  .gantt-popover-premium__body span
) {
  overflow-wrap: anywhere;
  word-break: break-word;
}


html[data-layout-chrome="compact"] .admin-floating-panel__header {
  padding: 0.65rem 0.85rem;
  min-width: 0;
}


html[data-layout-chrome="compact"] .admin-floating-panel__title {
  min-width: 0;
  flex: 1;
  line-height: 1.35;
}


html[data-layout-chrome="compact"] .admin-floating-panel--modal:not(.checkin-modal) .admin-floating-panel__body {
  padding: 0.85rem;
}


html[data-layout-chrome="compact"] .checkin-modal .admin-floating-panel__header {
  padding-inline: 0.85rem;
}


html[data-layout-chrome="compact"] .checkin-modal .checkin-stepper {
  padding-inline: 0.85rem;
}


html[data-layout-chrome="compact"] .gantt-filters-panel .admin-floating-panel__body {
  padding: 0.85rem;
}


html[data-layout-chrome="compact"] .gantt-popover-premium__actions {
  flex-direction: column;
}


html[data-layout-chrome="compact"] .gantt-popover-premium__btn {
  width: 100%;
  flex: none;
}


html[data-layout-chrome="compact"] .admin-panel .admin-panel-section {
  padding: 0.85rem;
}


html[data-layout-chrome="compact"] .admin-panel table {
  display: block;
  max-width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
}


html[data-layout-chrome="compact"] .bd-card {
  padding: 0.85rem;
  min-width: 0;
}


html[data-layout-chrome="compact"] .bd-card--tight {
  padding: 0.65rem 0.85rem;
}


html[data-layout-chrome="compact"] .availability-detail-panel > div {
  padding-inline: 0.85rem !important;
}


html[data-layout-chrome="compact"] .availability-detail-panel .avail-room-tile {
  flex-wrap: wrap;
  gap: 0.35rem;
}


html[data-layout-chrome="compact"] .availability-detail-panel .avail-room-tile span:last-child {
  margin-left: auto;
  text-align: right;
}


html[data-layout-chrome="compact"] .admin-quick-panel {
  padding: 0.85rem !important;
}


html[data-layout-chrome="compact"] .admin-quick-panel li > div:first-child {
  min-width: 0;
}


html[data-layout-chrome="compact"] .admin-quick-panel__confirm-link {
  width: 100%;
  justify-content: center !important;
}


html[data-layout-chrome="compact"] .ml-drawer {
  padding-inline: max(0.85rem, var(--ml-safe-left, 0px))
    max(0.85rem, var(--ml-safe-right, 0px));
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  contain: layout style paint;
}


html[data-layout-chrome="compact"] .ml-drawer__link {
  white-space: normal;
  line-height: 1.35;
}


html[data-layout-chrome="compact"] .admin-panel-section input,
html[data-layout-chrome="compact"] .admin-panel-section select,
html[data-layout-chrome="compact"] .admin-panel-section textarea {
  font-size: 16px;
  min-width: 0;
  width: 100%;
  max-width: 100%;
}


html[data-layout-chrome="compact"] .platform-tenant-detail__head + *,
html[data-layout-chrome="compact"] .nestio-admin-main .rounded-lg,
html[data-layout-chrome="compact"] .nestio-admin-main .rounded-xl {
  min-width: 0;
}


/* ── Pass 6: second mobile-more pass ── */

/* Statistics KPI cards: 2-up (override universal 1-col stack) */
html[data-layout-chrome="compact"] .admin-page .admin-panel .grid.sm\:grid-cols-2,
html[data-layout-chrome="compact"] .admin-page .admin-panel .grid.lg\:grid-cols-4 {
  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
}


html[data-layout-chrome="compact"] .admin-page .admin-panel .grid.sm\:grid-cols-3 {
  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
}


html[data-layout-chrome="compact"] .admin-page .admin-panel .grid > .rounded-2xl {
  min-width: 0;
}


html[data-layout-chrome="compact"] .admin-page .admin-panel .grid > .rounded-2xl p {
  overflow-wrap: anywhere;
}


/* Settings accordion triggers: full width on compact */
html[data-layout-chrome="compact"] .admin-settings-panel__trigger {
  width: 100%;
  box-sizing: border-box;
}


html[data-layout-chrome="compact"] .admin-settings-panel__trigger-main {
  min-width: 0;
  flex: 1;
}


html[data-layout-chrome="compact"] .admin-settings-panel__title,
html[data-layout-chrome="compact"] .admin-settings-panel__subtitle {
  overflow-wrap: anywhere;
  word-break: break-word;
}


/* Gantt filters panel: segment labels wrap inside narrow panel */
html[data-layout-chrome="compact"] .gantt-filters-panel .gantt-seg,
html[data-layout-chrome="compact"] .gantt-filters-panel .gantt-seg__track {
  min-width: 0;
}


html[data-layout-chrome="compact"] .gantt-filters-panel .gantt-seg__track {
  flex-wrap: wrap;
  gap: 0.25rem;
}


html[data-layout-chrome="compact"] .gantt-filters-panel .gantt-seg__btn {
  min-width: 0;
  flex: 1 1 calc(50% - 0.15rem);
  white-space: normal;
  line-height: 1.25;
  text-align: center;
  padding-inline: 0.35rem;
  font-size: 0.72rem;
}


html[data-layout-chrome="compact"] .gantt-filters-panel .gantt-seg__label {
  overflow-wrap: anywhere;
  line-height: 1.3;
}


/* Recepție phone booking: stack fields, aligned labels */
html[data-layout-chrome="compact"] .phone-booking-form .grid {
  grid-template-columns: minmax(0, 1fr) !important;
}


html[data-layout-chrome="compact"] .phone-booking-form label {
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: 0.15rem;
}


html[data-layout-chrome="compact"] .phone-booking-form input,
html[data-layout-chrome="compact"] .phone-booking-form select,
html[data-layout-chrome="compact"] .phone-booking-form textarea {
  width: 100%;
  box-sizing: border-box;
}


html[data-layout-chrome="compact"] .phone-booking-form button[type="submit"] {
  width: 100%;
}


/* Drawer links: icon + long labels without clip */
html[data-layout-chrome="compact"] .ml-drawer__link {
  min-width: 0;
}


html[data-layout-chrome="compact"] .ml-drawer--admin .ml-drawer__link > span:last-child {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
}


html[data-layout-chrome="compact"] .ml-drawer__locale {
  padding-inline: 0.1rem;
}


html[data-layout-chrome="compact"] .ml-drawer__locale .language-switcher {
  width: 100%;
}


html[data-layout-chrome="compact"] .ml-drawer__locale .language-switcher__trigger {
  width: 100%;
  justify-content: center;
}


/* Toast clears top nav chrome */
html[data-layout-chrome="compact"] .admin-toast-stack {
  top: calc(var(--ml-admin-nav-offset, calc(var(--ml-bottom-nav-height, 3.75rem) + var(--ml-safe-top, 0px))) + 0.5rem);
  right: max(0.65rem, var(--ml-safe-right, 0px));
  width: min(22rem, calc(100vw - 1.25rem));
}


html[data-layout-chrome="compact"] .admin-shell:has(.admin-hud-alert) .admin-toast-stack {
  top: calc(var(--ml-admin-nav-offset, calc(var(--ml-bottom-nav-height, 3.75rem) + var(--ml-safe-top, 0px))) + 2rem);
}


html[data-layout-chrome="compact"][data-layout-orientation="landscape"] .admin-toast-stack {
  top: calc(var(--ml-admin-nav-offset, calc(var(--ml-bottom-nav-height, 3.75rem) + var(--ml-safe-top, 0px))) + 0.35rem);
}


/* Booking banner: dates stack cleanly on narrow */
html[data-layout-chrome="compact"] .bd-banner__stay-row {
  flex-direction: column;
  align-items: stretch;
  gap: 0.5rem;
}


html[data-layout-chrome="compact"] .bd-banner__date-pair {
  min-width: 0;
}


html[data-layout-chrome="compact"] .bd-banner__date-sep {
  display: none;
}


html[data-layout-chrome="compact"] .bd-banner__meta {
  flex-wrap: wrap;
  gap: 0.35rem;
}


/* Nestio admin tables: scroll + sane cell widths */
html[data-layout-chrome="compact"] .ml-shell--nestio-admin table {
  min-width: 100%;
}


html[data-layout-chrome="compact"] .ml-shell--nestio-admin th,
html[data-layout-chrome="compact"] .ml-shell--nestio-admin td {
  min-width: 3.25rem;
  max-width: 11rem;
  overflow: hidden;
  text-overflow: ellipsis;
}


html[data-layout-chrome="compact"] .ml-shell--nestio-admin td:first-child,
html[data-layout-chrome="compact"] .ml-shell--nestio-admin th:first-child {
  min-width: 4.5rem;
  max-width: 9rem;
}


/* ── Pass 7: gear portal, safe areas, iOS, page polish ── */

/* Gear portaled menu: above HUD / Gantt chrome, below modals (100000) */
html[data-layout-chrome="compact"] .admin-gear__dropdown--portal {
  z-index: var(--z-overlay, 200);
  max-width: min(20rem, calc(var(--ml-vvw, 100vw) - 1rem));
  right: auto;
  overflow: visible;
  contain: none;
  box-shadow:
    0 8px 28px rgba(15, 23, 42, 0.18),
    0 2px 8px rgba(15, 23, 42, 0.08);
}


html[data-layout-chrome="compact"] .admin-gear__footer {
  overflow: visible;
}


html[data-layout-chrome="compact"] .admin-gear__item {
  font-size: 0.8125rem;
}


html[data-layout-chrome="compact"] .admin-hud,
html[data-layout-chrome="compact"] .admin-hud__surface,
html[data-layout-chrome="compact"] .admin-hud__header,
html[data-layout-chrome="compact"] .admin-hud__tools {
  overflow: visible;
}


/* Gantt footer legend: clear home indicator (no bottom nav) */
html[data-layout-chrome="compact"] .gantt-footer-legend--compact {
  margin-bottom: 0.15rem;
  padding-bottom: max(0.35rem, var(--ml-safe-bottom, 0px));
}


html[data-layout-chrome="compact"] .gantt-footer-legend__body {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem 0.65rem;
}


html[data-layout-chrome="compact"] .gantt-footer-legend__body .gantt-legend-swatch {
  flex-shrink: 0;
}


/* Devlog filters: horizontal pill scroll when crowded */
html[data-layout-chrome="compact"] .devlog-filters__group {
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
  scrollbar-width: none;
  padding-bottom: 0.15rem;
}


html[data-layout-chrome="compact"] .devlog-filters__group::-webkit-scrollbar {
  display: none;
}


html[data-layout-chrome="compact"] .devlog-filters__pill {
  flex-shrink: 0;
}


/* Location structure: stack cards, touch actions */
html[data-layout-chrome="compact"] .location-structure-page {
  padding-inline: 0.85rem !important;
}


html[data-layout-chrome="compact"] .location-structure-page article button,
html[data-layout-chrome="compact"] .location-structure-page article a,
html[data-layout-chrome="compact"] .location-structure-page article input,
html[data-layout-chrome="compact"] .location-structure-page article select {
  min-height: var(--ml-touch-min, 2.75rem);
  font-size: 16px;
}


html[data-layout-chrome="compact"] .location-structure-page article header {
  flex-direction: column;
  align-items: stretch;
}


/* Nestio tenant detail: back link + form controls */
html[data-layout-chrome="compact"] .platform-tenant-detail__head a {
  min-height: var(--ml-touch-min, 2.75rem);
  display: inline-flex;
  align-items: center;
  padding-inline: 0.15rem;
}


html[data-layout-chrome="compact"] .ml-shell--nestio-admin select,
html[data-layout-chrome="compact"] .ml-shell--nestio-admin input[type="text"],
html[data-layout-chrome="compact"] .ml-shell--nestio-admin button {
  font-size: 16px;
  min-height: var(--ml-touch-min, 2.75rem);
}


/* Booking detail: ops actions wrap on narrow */
html[data-layout-chrome="compact"] .bd-ops__actions {
  flex-wrap: wrap;
  gap: 0.35rem;
}


html[data-layout-chrome="compact"] .bd-ops__btn {
  flex: 1 1 calc(50% - 0.2rem);
  min-width: 0;
  justify-content: center;
}


html[data-layout-chrome="compact"] .bd-ops__steps {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
}


/* Recepție quick panel: full-width on phone */
html[data-layout-chrome="compact"] .admin-quick-panel {
  max-width: 100%;
  overflow-x: clip;
}


html[data-layout-chrome="compact"] .admin-quick-panel li > div:first-child span {
  overflow-wrap: anywhere;
  word-break: break-word;
}


/* Landscape tablet: HUD density + Gantt bottom clearance */
html[data-layout-chrome="compact"][data-layout-orientation="landscape"] .admin-hud__header {
  padding-top: max(0.25rem, var(--ml-safe-top, 0px));
}


html[data-layout-chrome="compact"][data-layout-orientation="landscape"] .admin-hud__title {
  font-size: 0.85rem;
}


html[data-layout-chrome="compact"][data-layout-orientation="landscape"] .gantt-calendar-page {
  padding-bottom: 0.25rem !important;
}


/* gantt-scroll viewport bounds: mobile-layout-compact-fixes.css + admin/gantt-mobile.css */

/* Cazări stay cards: action row stacks */
html[data-layout-chrome="compact"] .stay-card__actions {
  flex-direction: column;
  align-items: stretch;
  width: 100%;
}


html[data-layout-chrome="compact"] .stay-card__actions > * {
  width: 100%;
}


/* Check-in stepper: number badges don't shrink */
html[data-layout-chrome="compact"] .checkin-stepper__indicator-num {
  flex-shrink: 0;
}


html[data-layout-chrome="compact"] .checkin-modal {
  width: min(calc(var(--ml-vvw, 100vw) - 0.5rem), 28rem);
  max-width: calc(var(--ml-vvw, 100vw) - 0.5rem);
}


/* Gantt context menu: stay on-screen */
html[data-layout-chrome="compact"] .gantt-ctx-menu {
  z-index: var(--z-overlay, 200);
  max-height: min(70dvh, var(--ml-vvh, 100dvh));
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
}


/* Admin more menu scroll area — layout in mobile-layout-admin-pages.css */
html[data-layout-chrome="compact"] .ml-drawer--admin .ml-drawer__nav {
  padding-bottom: 0.15rem;
}


/* ── Pass 8: unverified panels / dialogs audit ── */

/* All modals (except check-in which has its own stack): scroll body + safe viewport */
html[data-layout-chrome="compact"] .admin-floating-panel--modal:not(.checkin-modal) {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  width: 100% !important;
  max-width: 100% !important;
  margin-inline: 0;
  border-radius: 1rem 1rem 0 0;
  max-height: min(
    92dvh,
    calc(var(--ml-vvh, 100dvh) - var(--ml-safe-top, 0px) - var(--ml-safe-bottom, 0px) - 1.5rem)
  );
}


html[data-layout-chrome="compact"] .admin-floating-panel--modal:not(.checkin-modal) .admin-floating-panel__body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
}


/* Popover panels (filters, stay chip): bounded viewport + scrollable body */
html[data-layout-chrome="compact"] .admin-floating-panel:not(.admin-floating-panel--modal) {
  display: flex;
  flex-direction: column;
  max-height: min(
    70dvh,
    calc(var(--ml-vvh, 100dvh) - var(--ml-safe-top, 0px) - var(--ml-safe-bottom, 0px) - 2rem)
  );
}


html[data-layout-chrome="compact"] .admin-floating-panel:not(.admin-floating-panel--modal) .admin-floating-panel__header {
  flex-shrink: 0;
}


html[data-layout-chrome="compact"] .admin-floating-panel:not(.admin-floating-panel--modal) .admin-floating-panel__body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
}


/* Gantt filters: dock below top nav instead of floating off-toolbar */
html[data-layout-chrome="compact"] .gantt-filters-panel.admin-floating-panel:not(.admin-floating-panel--modal) {
  left: 50% !important;
  right: auto !important;
  top: calc(var(--ml-admin-nav-offset, calc(var(--ml-bottom-nav-height, 3.75rem) + var(--ml-safe-top, 0px))) + 0.5rem) !important;
  bottom: auto !important;
  transform: translateX(-50%) !important;
  max-width: min(360px, calc(100vw - 1rem));
}


html[data-layout-chrome="compact"] .admin-floating-panel__btn {
  min-height: var(--ml-touch-min, 2.75rem);
  padding-block: 0.5rem;
  font-size: 0.875rem;
}


/* Alert / confirm dialogs */
html[data-layout-chrome="compact"] .admin-alert-dialog__actions {
  flex-direction: column;
  align-items: stretch;
  padding-inline: 0.85rem;
  padding-bottom: max(0.85rem, var(--ml-safe-bottom, 0px));
}


html[data-layout-chrome="compact"] .admin-alert-dialog__actions .admin-floating-panel__btn {
  width: 100%;
  justify-content: center;
}


html[data-layout-chrome="compact"] .admin-alert-dialog__message {
  padding-inline: 0.85rem;
  overflow-wrap: anywhere;
}


html[data-layout-chrome="compact"] .guest-preview-panel a.rounded {
  min-height: var(--ml-touch-min, 2.75rem);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding-inline: 1rem;
}


html[data-layout-chrome="compact"] .guest-preview-panel .admin-floating-panel__body > .space-y-4 {
  padding-inline: 0;
}


/* Gantt create / move / occupancy modals */
html[data-layout-chrome="compact"] .gantt-quick-panel.admin-floating-panel--modal,
html[data-layout-chrome="compact"] .gantt-move-room,
html[data-layout-chrome="compact"] .gantt-occ-detail {
  min-width: 0;
}


html[data-layout-chrome="compact"] .gantt-toolbar-occ-form input,
html[data-layout-chrome="compact"] .gantt-toolbar-occ-form select,
html[data-layout-chrome="compact"] .gantt-toolbar-occ-form textarea,
html[data-layout-chrome="compact"] .gantt-move-room input,
html[data-layout-chrome="compact"] .gantt-move-room select,
html[data-layout-chrome="compact"] .gantt-occ-detail input,
html[data-layout-chrome="compact"] .gantt-occ-detail select {
  font-size: 16px;
  min-height: var(--ml-touch-min, 2.75rem);
}


html[data-layout-chrome="compact"] .gantt-toolbar-occ-form button,
html[data-layout-chrome="compact"] .gantt-move-room button,
html[data-layout-chrome="compact"] .gantt-occ-detail button {
  min-height: var(--ml-touch-min, 2.75rem);
}


html[data-layout-chrome="compact"] .gantt-toolbar-occ-form .grid.sm\:grid-cols-2 {
  grid-template-columns: minmax(0, 1fr) !important;
}


html[data-layout-chrome="compact"] .gantt-toolbar-occ-form .flex.flex-wrap.items-center.gap-2 button {
  min-width: var(--ml-touch-min, 2.75rem);
  padding-inline: 0.65rem;
  font-size: 0.8125rem;
}


/* Operative check-in/out dialog (custom portal, not AdminFloatingPanel) */
html[data-layout-chrome="compact"] .gantt-check-time-dialog__backdrop {
  z-index: var(--z-overlay, 200);
}


html[data-layout-chrome="compact"] .gantt-check-time-dialog {
  z-index: calc(var(--z-overlay, 200) + 1);
  max-width: min(22rem, calc(100vw - 1rem));
  max-height: min(
    92dvh,
    calc(var(--ml-vvh, 100dvh) - var(--ml-safe-top, 0px) - var(--ml-safe-bottom, 0px) - 2rem)
  );
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  padding-bottom: max(1rem, var(--ml-safe-bottom, 0px));
}


html[data-layout-chrome="compact"] .gantt-check-time-dialog input[type="datetime-local"] {
  font-size: 16px;
  min-height: var(--ml-touch-min, 2.75rem);
  padding-block: 0.55rem;
}


html[data-layout-chrome="compact"] .gantt-check-time-dialog .mt-4.flex {
  flex-direction: column;
  align-items: stretch;
}


html[data-layout-chrome="compact"] .gantt-check-time-dialog .mt-4.flex button {
  width: 100%;
  min-height: var(--ml-touch-min, 2.75rem);
  font-size: 0.875rem;
  padding-block: 0.55rem;
}


/* Context menu backdrop aligned with menu stack */
html[data-layout-chrome="compact"] .gantt-ctx-menu-backdrop {
  z-index: calc(var(--z-overlay, 200) - 1);
}


/* Gantt mobile bottom sheets */
html[data-layout-chrome="compact"] .gantt-ctx-menu--sheet {
  top: auto !important;
  bottom: 0;
  left: 0 !important;
  right: 0;
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;
  border-radius: 1rem 1rem 0 0;
  padding-bottom: calc(0.35rem + var(--ml-safe-bottom, 0px));
}


html[data-layout-chrome="compact"] .gantt-ctx-menu--sheet .gantt-ctx-menu__confirm-msg {
  font-size: 0.8125rem;
  line-height: 1.35;
}


html[data-layout-chrome="compact"] .gantt-check-time-dialog--sheet {
  top: auto;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  max-width: 100%;
  transform: none;
  border-radius: 1rem 1rem 0 0;
  padding-bottom: calc(1rem + var(--ml-safe-bottom, 0px));
}


/* Settings location unlock */
html[data-layout-chrome="compact"] .admin-location-unlock input {
  font-size: 16px;
  max-width: 100%;
  min-height: var(--ml-touch-min, 2.75rem);
  width: 100%;
}


html[data-layout-chrome="compact"] .admin-location-unlock button {
  min-height: var(--ml-touch-min, 2.75rem);
  width: 100%;
}


/* SIM chip error toast inside gear dropdown */
html[data-layout-chrome="compact"] .admin-gear__footer .sim-error-toast {
  max-width: min(16rem, calc(100vw - 2rem));
  right: 0;
  left: auto;
  font-size: 0.72rem;
}


html[data-layout-chrome="compact"] .admin-gear__footer .sim-trigger-chip--compact {
  width: 100%;
  justify-content: center;
}


/* Admin panel error boundary */
html[data-layout-chrome="compact"] .ml-content.flex.min-h-\[40dvh\] {
  padding-bottom: var(--ml-safe-bottom, 0px);
}


/* Blacklist modal touch */
html[data-layout-chrome="compact"] .guest-blacklist-modal .admin-floating-panel__btn {
  min-height: var(--ml-touch-min, 2.75rem);
}


/* Availability KPI help popover */
html[data-layout-chrome="compact"] .avail-kpi-card + .admin-overlay-stack .admin-floating-panel {
  max-width: min(calc(100vw - 1rem), 20rem);
}


/* ── Pass 9: best mobile UX — focus, errors, sticky scroll targets ── */

html[data-layout-chrome="compact"] button:focus-visible,
html[data-layout-chrome="compact"] a:focus-visible,
html[data-layout-chrome="compact"] .ml-drawer__link:focus-visible,
html[data-layout-chrome="compact"] .ml-bottom-nav__link:focus-visible {
  outline: 2px solid color-mix(in srgb, var(--admin-accent, #38bdf8) 70%, white);
  outline-offset: 2px;
}


html[data-layout-chrome="compact"] .nestio-admin-error {
  padding-bottom: max(1.5rem, var(--ml-safe-bottom, 0px));
}


html[data-layout-chrome="compact"] .nestio-admin-error__card {
  width: min(100%, 24rem);
  margin-inline: auto;
}


html[data-layout-chrome="compact"] .nestio-admin-error__card button,
html[data-layout-chrome="compact"] .nestio-admin-error__card a {
  width: 100%;
}


/* Anchor scroll: section headings clear top nav */
html[data-layout-chrome="compact"] .admin-page-main :target,
html[data-layout-chrome="compact"] .ml-main :target {
  scroll-margin-top: calc(var(--ml-admin-nav-offset, calc(var(--ml-bottom-nav-height, 3.75rem) + var(--ml-safe-top, 0px))) + 0.75rem);
  scroll-margin-bottom: calc(var(--ml-safe-bottom, 0px) + 1rem);
}


/* Long-press context menus: avoid accidental selection on Gantt bars */
html[data-layout-chrome="compact"] .gantt-seg__btn,
html[data-layout-chrome="compact"] .gantt-room-label {
  -webkit-user-select: none;
