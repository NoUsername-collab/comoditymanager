  padding-block: 0.35rem;
  touch-action: manipulation;
}


html[data-layout-chrome="compact"] .bd-confirm__adjust-toggle input[type="checkbox"] {
  width: 1.25rem;
  height: 1.25rem;
  flex-shrink: 0;
}


html[data-layout-chrome="compact"] .admin-quick-panel__row {
  flex-direction: column;
  align-items: stretch;
  gap: 0.5rem;
}


html[data-layout-chrome="compact"] .admin-quick-panel__row > div {
  min-width: 0;
}


html[data-layout-chrome="compact"] .admin-quick-panel__row .admin-quick-panel__confirm-link {
  width: 100%;
  min-height: var(--ml-touch-min, 2.75rem);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding-block: 0.45rem;
  font-size: max(16px, 0.75rem);
  touch-action: manipulation;
}


html[data-layout-chrome="compact"] .language-switcher__trigger {
  min-height: var(--ml-touch-min, 2.75rem);
  min-width: var(--ml-touch-min, 2.75rem);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding-inline: 0.65rem;
  touch-action: manipulation;
}


html[data-layout-chrome="compact"] .language-switcher__menu--portal {
  max-width: min(12rem, calc(100vw - 1rem));
}


/* ── Pass 29: availability toolbar stack, drawer scroll, guest cards, perf ── */

html[data-layout-chrome="compact"] .avail-dashboard-toolbar {
  flex-direction: column;
  align-items: stretch;
  gap: 0.65rem;
  min-width: 0;
}


html[data-layout-chrome="compact"] .avail-display-mode {
  display: flex;
  width: 100%;
  border-radius: 0.75rem;
  border: 1px solid var(--admin-panel-border, #e4e4e7);
  background: var(--admin-panel-bg, #fff);
  padding: 0.2rem;
  gap: 0.2rem;
}


html[data-layout-chrome="compact"] .avail-display-mode button {
  flex: 1 1 0;
  min-width: 0;
  min-height: var(--ml-touch-min, 2.75rem);
  border-radius: 0.5rem;
  padding: 0.45rem 0.35rem;
  font-size: max(11px, 0.68rem);
  font-weight: 700;
  touch-action: manipulation;
}


html[data-layout-chrome="compact"] .avail-view-tabs {
  width: 100%;
  justify-content: stretch;
}


html[data-layout-chrome="compact"] .avail-view-tab {
  flex: 1 1 0;
  min-height: var(--ml-touch-min, 2.75rem);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: max(12px, 0.75rem);
  touch-action: manipulation;
}


html[data-layout-chrome="compact"] .availability-week-nav {
  flex-direction: column;
  align-items: stretch;
  gap: 0.45rem;
  margin-top: 0.65rem;
}


html[data-layout-chrome="compact"] .availability-week-nav__prev,
html[data-layout-chrome="compact"] .availability-week-nav__next {
  width: 100%;
  min-height: var(--ml-touch-min, 2.75rem);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 0.65rem;
  border: 1px solid color-mix(in srgb, var(--admin-accent, #059669) 35%, var(--admin-panel-border, #e4e4e7));
  background: var(--admin-panel-bg, #fff);
  font-size: max(13px, 0.8125rem);
  touch-action: manipulation;
}


html[data-layout-chrome="compact"] .avail-interval-bar {
  flex-direction: column;
  align-items: stretch;
  gap: 0.65rem;
}


html[data-layout-chrome="compact"] .avail-interval-bar__actions {
  flex-direction: column;
  width: 100%;
}


html[data-layout-chrome="compact"] .avail-interval-bar__copy,
html[data-layout-chrome="compact"] .avail-interval-bar__clear {
  width: 100%;
  min-height: var(--ml-touch-min, 2.75rem);
  font-size: max(13px, 0.8125rem);
  touch-action: manipulation;
}


html[data-layout-chrome="compact"] .guest-card__btn {
  min-height: var(--ml-touch-min, 2.75rem);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  touch-action: manipulation;
}


html[data-layout-chrome="compact"] .availability-month-matrix {
  content-visibility: auto;
  contain-intrinsic-size: auto 22rem;
  contain: layout style;
  box-shadow:
    0 1px 2px color-mix(in srgb, var(--admin-page-bg, #0f172a) 4%, transparent),
    0 4px 14px color-mix(in srgb, var(--admin-accent, #059669) 5%, transparent);
}


/* ── Pass 31: MRZ fullscreen camera, settings accordion, gantt cap touch ── */

html[data-layout-chrome="compact"] .mrz-scan-modal.admin-floating-panel--modal {
  top: 0 !important;
  bottom: 0 !important;
  left: 0 !important;
  right: 0 !important;
  width: 100% !important;
  max-width: 100% !important;
  max-height: var(--ml-vvh, 100dvh) !important;
  height: var(--ml-vvh, 100dvh) !important;
  margin: 0 !important;
  border-radius: 0 !important;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}


html[data-layout-chrome="compact"] .mrz-scan-modal .admin-floating-panel__body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  padding-bottom: max(0.75rem, var(--ml-safe-bottom, 0px));
}


html[data-layout-chrome="compact"] .mrz-scan__tab,
html[data-layout-chrome="compact"] .mrz-scan__parse-btn,
html[data-layout-chrome="compact"] .mrz-scan__actions .checkin-stepper__btn,
html[data-layout-chrome="compact"] .checkin-guest-form__mrz-btn {
  min-height: var(--ml-touch-min, 2.75rem);
  font-size: max(16px, 0.875rem);
  touch-action: manipulation;
}


html[data-layout-chrome="compact"] .mrz-scan__textarea {
  font-size: max(16px, 0.875rem);
  min-height: 6rem;
}


html[data-layout-chrome="compact"] .mrz-scan__camera-wrap {
  aspect-ratio: 3 / 4;
  max-height: min(52dvh, calc(var(--ml-vvh, 100dvh) - 14rem));
  border-radius: 0.85rem;
}


html[data-layout-chrome="compact"] .mrz-scan__torch-btn,
html[data-layout-chrome="compact"] .mrz-scan__manual-link {
  min-height: var(--ml-touch-min, 2.75rem);
  touch-action: manipulation;
}


html[data-layout-chrome="compact"] .mrz-scan__actions {
  position: sticky;
  bottom: 0;
  z-index: 2;
  flex-direction: column;
  gap: 0.5rem;
  padding-top: 0.65rem;
  background: var(--admin-panel-bg, #fff);
}


html[data-layout-chrome="compact"] .mrz-scan__actions .checkin-stepper__btn {
  width: 100%;
}


html[data-layout-chrome="compact"] .admin-settings-panel__trigger {
  position: sticky;
  top: 0;
  z-index: 2;
  background: color-mix(in srgb, var(--admin-panel-bg, #fff) 96%, transparent);
}


html[data-layout-chrome="compact"] .admin-settings-panel__body {
  overflow-x: clip;
}


html[data-layout-chrome="compact"] .admin-settings-form input,
html[data-layout-chrome="compact"] .admin-settings-form select,
html[data-layout-chrome="compact"] .admin-settings-form textarea {
  font-size: max(16px, 1rem);
  min-height: var(--ml-touch-min, 2.75rem);
}


html[data-layout-chrome="compact"] .gantt-stay--chip .gantt-stay__cap-strip {
  touch-action: manipulation;
}


html[data-layout-chrome="compact"] .gantt-stay--chip .gantt-stay__cap-strip .gantt-stay__alert,
html[data-layout-chrome="compact"] .gantt-stay--chip .gantt-stay__cap-strip .gantt-stay__badge {
  min-width: 0.62rem;
  min-height: 0.62rem;
}


html[data-layout-chrome="compact"] .gantt-compact-toolbar__icon-btn,
html[data-layout-chrome="compact"] .gantt-compact-toolbar__nav-btn--edge,
html[data-layout-chrome="compact"] .gantt-compact-toolbar__today-btn {
  min-width: var(--ml-touch-min, 2.75rem);
  min-height: var(--ml-touch-min, 2.75rem);
}


html[data-layout-chrome="compact"] .ml-drawer--admin .ml-drawer__close {
  min-width: var(--ml-touch-min, 2.75rem);
  min-height: var(--ml-touch-min, 2.75rem);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}


html[data-layout-chrome="compact"] .stay-card__actions {
  width: 100%;
  flex-direction: column;
  align-items: stretch;
  gap: 0.35rem;
}


html[data-layout-chrome="compact"] .stay-quick-ops {
  /* Grid + display:contents groups — admin-cazari-cards.css */
  gap: 0.4rem;
}


html[data-layout-chrome="compact"] .stay-quick-ops button,
html[data-layout-chrome="compact"] .stay-quick-ops a {
  justify-content: center;
}


@media (prefers-reduced-motion: reduce) {
  html[data-layout-chrome="compact"] .gantt-stay--chip .gantt-stay__cap-strip,
  html[data-layout-chrome="compact"] .gantt-cap-bulb-glow {
    animation: none !important;
  }
}


@media (display-mode: standalone) {
  html[data-layout-chrome="compact"] .ml-bottom-nav--admin {
    padding-top: max(0.45rem, var(--ml-safe-top, 0px));
  }

  html[data-layout-chrome="compact"] .admin-shell.ml-shell {
    padding-top: env(safe-area-inset-top, 0px);
  }

  html[data-layout-chrome="compact"] .mrz-scan-modal.admin-floating-panel--modal {
    padding-top: var(--ml-safe-top, 0px);
    padding-bottom: var(--ml-safe-bottom, 0px);
  }
}


html[data-layout-chrome="compact"] .ml-content {
  /* overflow-x: clip — mobile-layout-compact-fixes.css */
  scroll-padding-top: calc(var(--ml-admin-chrome-top, var(--ml-safe-top, 0px)) + 0.5rem);
  scroll-padding-bottom: var(
    --ml-page-scroll-bottom,
    calc(var(--ml-safe-bottom, 0px) + 0.35rem)
  );
}


/* ── Admin page frames ── */
html[data-layout-chrome="compact"] .admin-page-main > main,
html[data-layout-mode="mobile"] .admin-page-main > main {
  padding-block: var(--ml-page-gutter-block, 0.65rem) 0;
  padding-inline: 0;
}


html[data-layout-chrome="compact"] .admin-page-toolbar {
  flex-direction: column;
  align-items: stretch;
}


/* ── Paint isolation: off-screen sections skip layout on compact ── */
html[data-layout-chrome="compact"] .bd-col,
html[data-layout-chrome="compact"] .bd-card {
  content-visibility: auto;
  contain: layout style;
  contain-intrinsic-size: auto 12rem;
}


html[data-layout-chrome="compact"] .admin-home-kpi,
html[data-layout-chrome="compact"] .admin-home-panel,
html[data-layout-chrome="compact"] .admin-home-section {
  content-visibility: auto;
  contain: layout style;
  contain-intrinsic-size: auto 6rem;
}


html[data-layout-chrome="compact"] .admin-page .rounded-2xl.border {
  content-visibility: auto;
  contain: layout style;
  contain-intrinsic-size: auto 5rem;
}


html[data-layout-chrome="compact"] .admin-page-main,
html[data-layout-chrome="compact"] .ml-main,
html[data-layout-chrome="compact"] .admin-panel__body {
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-y: contain;
  scroll-padding-bottom: var(--ml-page-scroll-bottom, calc(var(--ml-safe-bottom, 0px) + 0.35rem));
}


/* admin panels: see mobile-layout-flawless.css (.admin-panel) */

html[data-layout-chrome="compact"] .admin-page-back {
  font-size: 0.8125rem;
}


/* ── Admin settings / forms (see mobile-layout-admin-pages.css) ── */

html[data-layout-chrome="compact"] .admin-panel-section {
  padding: 1rem 0.85rem;
  min-width: 0;
}


html[data-layout-chrome="compact"] .admin-panel-section__title,
html[data-layout-chrome="compact"] .admin-panel-section__desc {
  overflow-wrap: anywhere;
  word-break: break-word;
}


html[data-layout-chrome="compact"] .admin-gear__dropdown:not(.admin-gear__dropdown--portal) {
  max-width: min(20rem, calc(var(--ml-vvw, 100vw) - 1rem));
  right: 0;
  left: auto;
}


html[data-layout-chrome="compact"] .admin-gear__dropdown--portal {
  max-width: min(20rem, calc(var(--ml-vvw, 100vw) - 1rem));
  right: auto;
  overflow: visible;
  contain: none;
}


/* ── Booking detail & modals ── */
html[data-layout-chrome="compact"] .admin-modal,
html[data-layout-chrome="compact"] .checkin-modal {
  width: min(calc(var(--ml-vvw, 100vw) - 1rem), 28rem);
  max-height: min(92dvh, var(--ml-vvh, 100dvh));
  margin-inline: auto;
}


/* sim strip: see mobile-layout-flawless.css */

/* ── Nestio admin ── */
.ml-shell--nestio-admin .nestio-admin-header__nav--wide {
  display: flex;
}


html[data-layout-chrome="compact"] .ml-shell--nestio-admin .nestio-admin-header__nav--wide {
  display: none;
}


html[data-layout-chrome="compact"] .ml-shell--nestio-admin .nestio-admin-header__inner {
  gap: 0.5rem;
}


html[data-layout-chrome="compact"] .ml-shell--nestio-admin .nestio-admin-header__email {
  display: none;
}


/* ── Auth / login ── */
html[data-layout-chrome="compact"] .admin-login-page {
  padding: max(1rem, var(--ml-safe-top)) 1rem max(1rem, var(--ml-safe-bottom));
  align-items: flex-start;
  padding-top: max(2rem, var(--ml-safe-top));
}


html[data-layout-chrome="compact"] .admin-login-card {
  padding: 1rem !important;
  border-radius: 0.75rem;
}


html[data-layout-chrome="compact"] .admin-corner {
  min-height: var(--ml-touch-min, 2.75rem);
  padding-inline: 0.65rem;
}


/* ── Tablet portrait uses compact chrome too ── */
html[data-layout-chrome="compact"][data-layout-mode="tablet"] .admin-shell {
  padding-bottom: 0;
}


/* PWA install banner — apare la prima vizită mobilă */
.pwa-install-banner {
  position: fixed;
  bottom: max(0.75rem, var(--ml-safe-bottom, 0px));
  left: 0.75rem;
  right: 0.75rem;
  z-index: calc(var(--z-overlay, 200) - 1);
  display: flex;
  align-items: center;
  gap: 0.65rem;
  padding: 0.65rem 0.75rem;
  border-radius: 1rem;
  background: var(--admin-card, #1a1a2e);
  border: 1px solid rgba(124, 58, 237, 0.3);
  box-shadow: 0 8px 24px rgb(0 0 0 / 0.3);
  color: var(--admin-text, #e8e8f0);
  animation: pwa-banner-slide-up 0.3s ease;
}


.pwa-install-banner__title {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--admin-text, #e8e8f0);
}


.pwa-install-banner__sub {
  font-size: 0.75rem;
  color: var(--admin-text-muted, #8888aa);
}


.pwa-install-banner__close {
  flex-shrink: 0;
  width: 2rem;
  height: 2rem;
  min-height: 44px;
  min-width: 44px;
  display: grid;
  place-items: center;
  border: none;
  background: transparent;
  color: var(--admin-text-muted, #8888aa);
  font-size: 0.85rem;
  cursor: pointer;
  border-radius: 0.4rem;
  padding: 0;
}


.pwa-install-banner__close:active {
  color: var(--admin-text, #e8e8f0);
}


.pwa-install-sheet {
  position: fixed;
  z-index: calc(var(--z-overlay, 200) + 1);
  left: 0.75rem;
  right: 0.75rem;
  bottom: max(0.75rem, var(--ml-safe-bottom, 0px));
  padding: 1rem 1.1rem 1.1rem;
  border-radius: 1rem;
  background: var(--surface-1, #fff);
  color: var(--admin-text, #18181b);
  box-shadow: 0 16px 48px rgb(0 0 0 / 0.22);
}


.pwa-install-sheet__hint {
  margin: 0 0 0.75rem;
  font-size: 0.8rem;
  color: var(--admin-muted, #71717a);
  line-height: 1.4;
}


.pwa-install-sheet__close {
  width: 100%;
  min-height: 2.75rem;
  border: none;
  border-radius: 0.65rem;
  background: var(--admin-accent, #059669);
  color: #fff;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
}


/* PWA standalone (Add to Home Screen) — full safe-area on notched phones */
@media (display-mode: standalone) {
  html[data-layout-chrome="compact"] .ml-bottom-nav--admin {
    padding-bottom: max(0.15rem, var(--ml-safe-bottom, 0px));
  }

  html[data-layout-chrome="compact"] .admin-shell.ml-shell {
    padding-top: env(safe-area-inset-top, 0px);
  }

  html[data-layout-chrome="compact"] .public-header,
  html[data-layout-chrome="compact"] .nestio-admin-header,
  html[data-layout-chrome="compact"] .admin-hud__header {
    padding-top: max(0.5rem, var(--ml-safe-top, 0px));
  }

  html[data-layout-chrome="compact"] .ml-drawer--admin {
    padding-top: max(0.75rem, var(--ml-safe-top, 0px));
  }
}


/* ═══ mobile-layout-alignment.css ═══ */
/**
 * Mobile alignment — single gutter contract for compact chrome.
 * Parent: .admin-page-main owns horizontal inset; children stay flush.
 */

html[data-layout-chrome="compact"] {
  --ml-page-gutter: 0.85rem;
  --ml-page-gutter-tight: 0.35rem;
  --ml-page-gutter-block: 0.65rem;
  --ml-page-inline-start: max(var(--ml-page-gutter), var(--ml-safe-left, 0px));
  --ml-page-inline-end: max(var(--ml-page-gutter), var(--ml-safe-right, 0px));
}


/* ── Admin shell: one gutter source ── */
html[data-layout-chrome="compact"] .admin-shell .admin-page-main {
  padding-inline: var(--ml-page-inline-start) var(--ml-page-inline-end);
  padding-block-start: 0;
  /* padding-bottom: mobile-layout-compact-fixes.css (--ml-content-pad-bottom) */
  box-sizing: border-box;
}


html[data-layout-chrome="compact"] .admin-page-main > main,
html[data-layout-chrome="compact"] .admin-page-main > .ml-content,
html[data-layout-chrome="compact"] .admin-page-main .admin-page,
html[data-layout-chrome="compact"] .admin-page-main .ml-content.admin-page {
  padding-inline: 0 !important;
  margin-inline: 0;
  max-width: 100%;
  min-width: 0;
}


html[data-layout-chrome="compact"] .admin-page-main > main.admin-page,
html[data-layout-chrome="compact"] .admin-page-main .admin-page.p-3,
html[data-layout-chrome="compact"] .admin-page-main .admin-page.sm\:p-4 {
  padding: 0 !important;
}


/* HUD + alerts align with page gutter */
html[data-layout-chrome="compact"] .admin-hud__header {
  padding-inline: var(--ml-page-inline-start) var(--ml-page-inline-end);
}


html[data-layout-chrome="compact"] .admin-hud-alert {
  padding-inline: var(--ml-page-inline-start) var(--ml-page-inline-end);
}


html[data-layout-chrome="compact"] .admin-hud__center {
  margin-inline: 0;
  padding-inline: 0;
}


/* Settings / nested pages — no second gutter */
html[data-layout-chrome="compact"] .admin-settings-page,
html[data-layout-chrome="compact"] .admin-settings-summary {
  padding-inline: 0 !important;
  padding-block: 0 !important;
}


html[data-layout-chrome="compact"] .admin-settings-shell {
  padding-inline: 0;
}


/* Gantt: tight but symmetric gutter */
html[data-layout-chrome="compact"] .admin-shell:has(.gantt-calendar-page) .admin-page-main {
  padding-inline: max(var(--ml-page-gutter-tight), var(--ml-safe-left, 0px))
    max(var(--ml-page-gutter-tight), var(--ml-safe-right, 0px));
}


html[data-layout-chrome="compact"] .gantt-calendar-page.admin-page {
  padding: 0 !important;
}


html[data-layout-chrome="compact"] .gantt-calendar-page .gantt-page-top-cards {
  padding-inline: 0;
}


html[data-layout-chrome="compact"] .gantt-calendar-page .gantt-compact-toolbar {
  margin-inline: 0 !important;
}


/* Platform / platform-admin — single gutter (no Tailwind px-* stacking) */
html[data-layout-chrome="compact"] .ml-shell--platform-admin .platform-admin-main,
html[data-layout-chrome="compact"] .ml-shell--nestio-admin .nestio-admin-main {
  padding-inline: var(--ml-page-inline-start) var(--ml-page-inline-end);
  padding-block: var(--ml-page-gutter-block)
    max(var(--ml-page-gutter-block), var(--ml-safe-bottom, 0px));
  max-width: 100%;
  min-width: 0;
  overflow-x: clip;
  box-sizing: border-box;
}


html[data-layout-chrome="compact"] .ml-shell--platform-admin .platform-admin-header__inner,
html[data-layout-chrome="compact"] .ml-shell--nestio-admin .nestio-admin-header__inner {
  padding-inline: var(--ml-page-inline-start) var(--ml-page-inline-end);
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}


html[data-layout-chrome="compact"] .ml-shell--nestio-admin .nestio-admin-main .grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}


html[data-layout-chrome="compact"] .ml-shell--nestio-admin .platform-tenant-toolbar {
  position: sticky;
  top: 0;
  z-index: 3;
  margin-inline: 0;
  padding-block: 0.35rem 0.5rem;
  background: color-mix(in srgb, #0a0a0a 94%, transparent);
  backdrop-filter: blur(8px);
}


/* Tablet portrait — same gutter token (no 1.1rem drift) */
html[data-layout-chrome="compact"][data-layout-mode="tablet"][data-layout-orientation="portrait"]
  .admin-page-main {
  padding-inline: var(--ml-page-inline-start) var(--ml-page-inline-end);
}


/* UX: sticky cazări filters + horizon on compact */
html[data-layout-chrome="compact"] .cazari-sticky-toolbar {
  position: sticky;
  top: 0;
  z-index: 3;
  margin-inline: 0;
  padding-block: 0.28rem 0.18rem;
  background: color-mix(in srgb, var(--admin-surface-bg, #fff) 92%, transparent);
  backdrop-filter: blur(8px);
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}


html[data-layout-chrome="compact"] .cazari-view-filter {
  min-height: var(--ml-touch-min, 2.75rem);
  padding: 0.45rem 0.55rem;
  font-size: 0.75rem;
}


html[data-layout-chrome="compact"] .cazari-horizon__pill {
  min-height: var(--ml-touch-min, 2.75rem);
  display: inline-flex;
  align-items: center;
  padding: 0.35rem 0.65rem;
  font-size: 0.75rem;
}


/* UX: pinned cereri section — clear separation */
html[data-layout-chrome="compact"] .cazari-pinned-cereri {
  margin-bottom: 0.75rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--admin-surface-border, #e4e4e7);
  border-left: 3px solid var(--pending-border, #f59e0b);
  padding-left: 0.5rem;
}


html[data-layout-chrome="compact"] .cazari-pinned-cereri .admin-panel__titlebar {
  background: color-mix(in srgb, var(--admin-tint-warning-bg, #fffbeb) 75%, transparent);
}


/* Pass 31: zero double gutter on all admin pages */
html[data-layout-chrome="compact"] .admin-page-main .admin-page {
  padding-inline: 0 !important;
  padding-block: var(--ml-page-gutter-block) 0.5rem !important;
  max-width: 100%;
  min-width: 0;
  overflow-x: clip;
}


html[data-layout-chrome="compact"] .admin-page-main .admin-page.gantt-calendar-page,
html[data-layout-chrome="compact"] .admin-page-main .admin-page.admin-settings-page {
  padding-block: 0 !important;
}


/* Pass 31: sticky page context (guests, settings, home) */
html[data-layout-chrome="compact"] .admin-page-toolbar {
  position: sticky;
  top: 0;
  z-index: 4;
  margin-inline: 0;
  padding-block: 0.35rem 0.5rem;
  background: color-mix(in srgb, var(--admin-surface-bg, #fff) 94%, transparent);
  backdrop-filter: blur(8px);
}


html[data-layout-chrome="compact"] .guest-search {
  position: sticky;
  top: 0;
  z-index: 3;
  margin-inline: 0;
  padding-block: 0.35rem 0.45rem;
  background: color-mix(in srgb, var(--admin-surface-bg, #fff) 94%, transparent);
  backdrop-filter: blur(8px);
}


/* Pass 31: cazări horizon — horizontal pill scroll, no wrap overflow */
html[data-layout-chrome="compact"] .cazari-horizon {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 0.35rem;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
  scroll-snap-type: x proximity;
  padding-bottom: 0.15rem;
  margin-inline: 0;
  scrollbar-width: none;
}


html[data-layout-chrome="compact"] .cazari-horizon::-webkit-scrollbar {
  display: none;
}


html[data-layout-chrome="compact"] .cazari-horizon__label {
  flex-shrink: 0;
}


html[data-layout-chrome="compact"] .cazari-horizon a,
html[data-layout-chrome="compact"] .cazari-horizon__pill {
  flex-shrink: 0;
  scroll-snap-align: start;
}


html[data-layout-chrome="compact"] .cazari-sticky-toolbar {
  margin-inline: 0;
  padding-inline: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}


/* Pass 31: list paint isolation */
html[data-layout-chrome="compact"] .stay-list > li,
html[data-layout-chrome="compact"] .stay-card {
  content-visibility: auto;
  contain: layout style;
  contain-intrinsic-size: auto 7rem;
}


html[data-layout-chrome="compact"] .admin-home-cereri-item {
  content-visibility: auto;
  contain: layout style;
  contain-intrinsic-size: auto 4.5rem;
}


@media (prefers-reduced-motion: reduce) {
  html[data-layout-chrome="compact"] .cazari-sticky-toolbar,
  html[data-layout-chrome="compact"] .admin-page-toolbar,
  html[data-layout-chrome="compact"] .guest-search {
    backdrop-filter: none;
  }
}


/* ── Pass 32: gutter safe-area, overflow, skeletons, cazări ops, MRZ camera ── */

html[data-layout-chrome="compact"] .admin-shell.ml-shell {
  overflow-x: clip;
  max-width: 100%;
  padding-top: var(--ml-admin-chrome-top, var(--ml-safe-top, 0px));
}


html[data-layout-chrome="compact"] .admin-route-skeleton--list,
html[data-layout-chrome="compact"] .admin-route-skeleton--gantt,
html[data-layout-chrome="compact"] .admin-route-skeleton--availability,
html[data-layout-chrome="compact"] .admin-route-skeleton--panel-home {
  min-height: min(70dvh, calc(var(--ml-vvh, 100dvh) - var(--ml-admin-nav-offset, 3.25rem) - 2rem));
  contain: layout style;
}


html[data-layout-chrome="compact"] .admin-route-skeleton--gantt {
  display: flex;
  flex-direction: column;
  min-height: min(
    75dvh,
    calc(var(--ml-vvh, 100dvh) - var(--ml-admin-nav-offset, 3.25rem) - var(--ml-safe-bottom, 0px) - 1rem)
  );
}


html[data-layout-chrome="compact"] .admin-route-skeleton--gantt .admin-route-skeleton__grid {
  flex: 1;
  min-height: 12rem;
}


html[data-layout-chrome="compact"] .mrz-scan-modal .mrz-scan__camera-wrap {
  aspect-ratio: auto;
  width: 100%;
  max-height: min(68dvh, calc(var(--ml-vvh, 100dvh) - 10rem));
  min-height: min(52dvh, calc(var(--ml-vvh, 100dvh) - 12rem));
  border-radius: 0;
}


html[data-layout-chrome="compact"] .mrz-scan-modal .mrz-scan__camera-wrap video {
  object-fit: cover;
  width: 100%;
  height: 100%;
}


html[data-layout-chrome="compact"] .cerere-item,
html[data-layout-chrome="compact"] .platform-tenant-card,
html[data-layout-chrome="compact"] .statistics-page .statistics-card {
  content-visibility: auto;
  contain: layout style;
  contain-intrinsic-size: auto 5rem;
}


/* Scroll root: safe-area tail only — bottom nav is outside this flex scroll child */
html[data-layout-chrome="compact"] .admin-shell .admin-page-main {
  padding-bottom: var(--ml-content-pad-bottom);
  scroll-padding-bottom: var(
    --ml-page-scroll-bottom,
    calc(var(--ml-safe-bottom, 0px) + 0.35rem)
  );
}


/* Gantt owns the viewport — no double pad on the scroll shell */
html[data-layout-chrome="compact"] .admin-shell:has(.gantt-calendar-page) .admin-page-main {
  padding-bottom: 0;
  scroll-padding-bottom: var(--ml-safe-bottom, 0px);
}


/* Zero horizontal bleed on 390px — clip page columns */
html[data-layout-chrome="compact"] .admin-shell,
html[data-layout-chrome="compact"] .admin-page,
html[data-layout-chrome="compact"] .cazari-page,
html[data-layout-chrome="compact"] .admin-settings-page,
html[data-layout-chrome="compact"] .admin-settings-shell,
html[data-layout-chrome="compact"] .gantt-calendar-page .gantt-shell,
html[data-layout-chrome="compact"] .gantt-calendar-page .gantt-page-top-cards {
  overflow-x: clip;
  max-width: 100%;
  min-width: 0;
}


/* Settings: sticky save bar clearance + accordion touch */
html[data-layout-chrome="compact"] .admin-settings-page .settings-form-stack,
html[data-layout-chrome="compact"] .admin-settings-page .admin-settings-panel__inner {
  padding-bottom: 0.35rem;
}


html[data-layout-chrome="compact"] .admin-settings-panel__trigger {
  min-height: var(--ml-touch-min, 2.75rem);
  padding-block: 0.65rem;
  gap: 0.5rem;
}


html[data-layout-chrome="compact"] .admin-settings-panel__body--open .admin-settings-panel__inner {
  padding-block: 0.5rem 0.75rem;
}


/* Cazări: shorter cards, actions contained */
html[data-layout-chrome="compact"] .stay-card {
  contain-intrinsic-size: auto 4rem;
  overflow-x: clip;
  gap: 0.45rem !important;
  padding-block: 0.5rem !important;
}


/* Gantt portrait: bounded flex scroll (nav already excluded by shell flex) */
html[data-layout-chrome="compact"][data-layout-orientation="portrait"] .gantt-calendar-page .gantt-scroll {
  min-height: 10rem;
  max-height: calc(
    var(--ml-vvh, 100dvh)
      - var(--ml-admin-bottom-clearance, calc(var(--ml-bottom-nav-height) + var(--ml-safe-bottom)))
      - var(--ml-admin-chrome-top, var(--ml-safe-top, 0px))
      - 5.75rem
  );
  scroll-padding-bottom: var(--ml-safe-bottom, 0px);
}


/* Gantt: cap strip + stay tap targets */
html[data-layout-chrome="compact"] .gantt-stay--chip .gantt-stay-chrome {
  overflow-x: clip;
  min-width: 0;
  touch-action: manipulation;
}


html[data-layout-chrome="compact"] .gantt-stay--chip .gantt-stay__cap-strip {
  max-width: 100%;
  overflow: hidden;
  flex-shrink: 1;
  min-width: 0;
}


html[data-layout-chrome="compact"] .gantt-stay--chip .gantt-stay__cap-strip .gantt-stay__alert,
html[data-layout-chrome="compact"] .gantt-stay--chip .gantt-stay__cap-strip .gantt-stay__badge {
  flex-shrink: 0;
}


html[data-layout-chrome="compact"] .gantt-compact-toolbar__select,
html[data-layout-chrome="compact"] .gantt-compact-toolbar__icon-btn,
html[data-layout-chrome="compact"] .gantt-compact-toolbar__nav-btn,
html[data-layout-chrome="compact"] .gantt-compact-toolbar__today-btn,
html[data-layout-chrome="compact"] .gantt-compact-toolbar__period-jump {
  min-width: var(--gantt-touch-min, 2.75rem);
  min-height: var(--gantt-touch-min, 2.75rem);
}


/* Check-in: keyboard scroll clearance */
html[data-layout-chrome="compact"] .checkin-modal .checkin-stepper__content {
  scroll-padding-bottom: calc(var(--ml-safe-bottom, 0px) + 4.5rem);
}


html[data-layout-chrome="compact"] .checkin-modal .checkin-field__input:focus,
html[data-layout-chrome="compact"] .checkin-modal .checkin-field__select:focus,
html[data-layout-chrome="compact"] .checkin-modal textarea:focus {
  scroll-margin-bottom: calc(var(--ml-safe-bottom, 0px) + 3.5rem);
}


/* MRZ: camera fills modal body */
html[data-layout-chrome="compact"] .mrz-scan-modal .mrz-scan__camera-wrap {
  flex: 1 1 auto;
  aspect-ratio: auto;
  width: 100%;
  min-height: min(62dvh, calc(var(--ml-vvh, 100dvh) - 9rem));
  max-height: none;
  border-radius: 0.5rem;
}


html[data-layout-chrome="compact"] .mrz-scan-modal .admin-floating-panel__body {
  display: flex;
  flex-direction: column;
}


/* Bottom nav: stronger active affordance */
html[data-layout-chrome="compact"] .ml-bottom-nav__link--active {
  box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--admin-accent, #d6b55a) 38%, transparent);
}


/* ═══ Touch targets — minimum 44px pe dispozitive touch ═══ */
/*
 * iOS HIG și WCAG 2.5.8 cer min 44×44px pentru orice element interactiv.
 * Scoped strict pe pointer: coarse (touch) ca să nu afecteze desktop.
 */
@media (pointer: coarse) {
  button:not([data-touch-unconstrained]),
  [role="button"]:not([data-touch-unconstrained]),
  input[type="checkbox"],
  input[type="radio"],
  select,
  summary {
    min-height: 44px;
  }

  /* Link-uri de navigare admin */
  .ml-bottom-nav__link,
  .ml-drawer__link,
  .admin-gear__item {
    min-height: 44px;
  }

  /* Butoane mici cu icon (stepper +/−, toggle, preview ↗) */
  .checkin-stepper__btn,
  .guest-card__preview-btn,
  .checkin-toggle,
  .admin-hud__btn {
    min-height: 44px;
    min-width: 44px;
  }

  /* Dropdown-uri și select-uri native */
  select {
    min-height: 44px;
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
  }
}


/* ═══════════════════════════════════════════════════════════
   MOBILE GPU & ANIMATION BUDGET
   ═══════════════════════════════════════════════════════════ */

@media (pointer: coarse) {
  /*
   * Blob-urile liquid background (admin-dn-drift-*) rulează
   * filter:blur(42px) + transform infinit — cel mai scump lucru
   * pe mobile GPU. Le oprim animațiile și reducem blur-ul.
   */
  .admin-dn-liquid__blob {
    animation-play-state: paused !important;
    filter: blur(18px); /* 42px → 18px: blur cost ∝ radius², 5× mai ieftin */
    will-change: auto; /* eliberăm GPU layer-ul rezervat inutil */
  }

  /* Logo float e decorativ — oprim pe mobile */
  .brand-logo-shell,
  .group:hover .brand-logo-shell {
    animation: none;
  }

  /* HUD sync dot pulse — OK dacă e doar opacity, fără transform scale */
  .admin-hud__sync-dot--live {
    animation: none;
    opacity: 0.9;
  }

  /* Bottom nav active indicator — GPU layer explicit pentru scaleX */
  .ml-bottom-nav__link::before {
    will-change: transform;
  }

  /* Dezactivăm hover transforms pe mobile — nu există hover real */
  .admin-hud__chip--ghost:hover {
    transform: none;
    background: var(--admin-chip-bg, var(--admin-surface-bg, #ffffff));
    border-color: var(--admin-chip-border, #e4e4e7);
    box-shadow: none;
  }
}


/* prefers-reduced-motion: oprește absolut totul continuu */
@media (prefers-reduced-motion: reduce) {
  .admin-dn-liquid__blob {
    animation: none !important;
    filter: none;
    opacity: 0.3;
  }

  .admin-hud__sync-dot--live,
  .admin-cereri-glow-pulse,
  .setup-issue-badge {
    animation: none !important;
  }
}


@media (pointer: coarse) {
  /*
   * backdrop-filter pe sticky toolbars cauzează re-compositare la fiecare
   * frame de scroll pe Android mid-range. Înlocuim cu background opac.
   */
  html[data-layout-chrome="compact"] .cazari-sticky-toolbar,
  html[data-layout-chrome="compact"] .admin-page-toolbar,
  html[data-layout-chrome="compact"] .guest-search {
    backdrop-filter: none;
    background: var(--admin-surface-bg, #fff);
  }

  html[data-layout-chrome="compact"] .admin-page-main > .admin-page-toolbar--dark {
    backdrop-filter: none;
    background: color-mix(in srgb, #0a0a0a 98%, transparent);
  }

  /* Admin gear trigger — backdrop-filter: blur(10px) inutilă pe mobile */
  .admin-gear__trigger {
    backdrop-filter: none;
    background: rgba(255, 255, 255, 0.12);
  }
}
